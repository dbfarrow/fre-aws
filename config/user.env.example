# fre-aws user configuration — EXAMPLE FILE
#
# Copy this file to config/user.env and fill in your values:
#   cp config/user.env.example config/user.env
#
# config/user.env is gitignored and never committed — safe to store
# personal settings there without risk of accidental exposure.
# Your admin will provide these values in your onboarding bundle.

# Your username in this fre-aws environment.
MY_USERNAME=

# Project name (must match the admin's PROJECT_NAME in admin.env).
PROJECT_NAME=

# AWS CLI profile name for this project (from your onboarding bundle's aws-config).
AWS_PROFILE=claude-code

# AWS region where your instance is deployed.
AWS_REGION=us-east-1

# S3 state bucket name (from your onboarding bundle's user.env).
TF_BACKEND_BUCKET=

# ---- Local shell / run -------------------------------------------------------

# Base directory where project code is synced locally (default: ~/claude).
# Projects land at ${LOCAL_SYNC_DIR}/<project-name>/ — visible, Finder-friendly.
# LOCAL_SYNC_DIR=~/claude

# Per-project extra mounts for local-shell (space-separated host:container pairs).
# Use the project name with hyphens replaced by underscores as the variable suffix.
# Example — project "sqrt-analysis" needs ~/.sqrt mounted:
# LOCAL_MOUNTS_sqrt_analysis=~/.sqrt:~/.sqrt
# Multiple mounts:
# LOCAL_MOUNTS_my_project=~/.config/myapp:~/.config/myapp ~/.secrets/tokens:~/.secrets/tokens
