# Dockerfile.run — Base image for running user programs locally via ./user.sh run
# Extend with .fre-run.dockerfile in your project root for project-specific deps.
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    nodejs \
    npm \
    curl \
    wget \
    jq \
    git \
    ca-certificates \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV UV_BREAK_SYSTEM_PACKAGES=1

WORKDIR /app
